{
  "name": "my-app",
  "version": "2.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "vitest run --maxWorkers=2 && npm run test:report-contracts && npm run test:release-config",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "build:release": "node scripts/build-release.mjs",
    "release:check": "node scripts/build-release.mjs --check",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:report-contracts": "node --experimental-strip-types --test test/report-contracts.test.mjs",
    "test:release-config": "node --test test/release-config.test.mjs",
    "test:pos": "vitest run test/sale-page.test.tsx",
    "test:ui": "vitest run test/ui-foundation.test.tsx",
    "test:shell": "vitest run test/staff-shell.test.tsx"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
